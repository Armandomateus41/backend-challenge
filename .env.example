# Copy to .env for local development. Bun loads .env automatically.
# Values below target the services started by `docker compose up -d postgres localstack`.
DATABASE_URL=postgres://wagering:wagering@localhost:55432/wagering
TEST_DATABASE_URL=postgres://wagering:wagering@localhost:55432/wagering_test
DATABASE_POOL_MAX=20
DATABASE_LOCK_TIMEOUT_MS=5000

HTTP_PORT=8080
INSTANCE_ID=local-1
LOG_LEVEL=info
SUPPORTED_CURRENCIES=BRL
SHUTDOWN_TIMEOUT_MS=20000
# Queue requests per wallet in memory before they take a database connection.
WALLET_GATE_ENABLED=true

# LocalStack credentials are placeholders accepted by the emulator; they are not secrets.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo
SQS_CONSUMER_ENABLED=true
SQS_MAX_ATTEMPTS=5
SQS_WAIT_TIME_SECONDS=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_RETRY_BASE_DELAY_SECONDS=2
SQS_RETRY_MAX_DELAY_SECONDS=300

OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000

PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=50
PENDING_REFERENCE_MAX_ATTEMPTS=8
PENDING_REFERENCE_BASE_DELAY_MS=1000
PENDING_REFERENCE_MAX_DELAY_MS=60000

# Retention of processed inbox rows and published outbox rows. Inbox retention must exceed the
# longest time a message can still be redelivered (queue and DLQ retention).
RETENTION_ENABLED=true
RETENTION_INTERVAL_MS=3600000
RETENTION_BATCH_SIZE=1000
INBOX_RETENTION_HOURS=336
OUTBOX_RETENTION_HOURS=168

# Provider authentication (OIDC client credentials). Disabled by default; the local IdP is
# started with: docker compose --profile auth up -d --wait keycloak
AUTH_ENABLED=false
AUTH_ISSUER=http://localhost:8180/realms/wagering
AUTH_JWKS_URL=http://localhost:8180/realms/wagering/protocol/openid-connect/certs
AUTH_AUDIENCE=wagering-api
AUTH_PROVIDER_CLAIM=provider_id
